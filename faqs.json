<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jaecoo J6 Owners SG - Knowledge Base & FAQ</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen font-sans selection:bg-emerald-500 selection:text-white flex flex-col justify-between">
    <div>
        <!-- Header -->
        <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-50 backdrop-blur-md bg-opacity-90">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-emerald-900/30">
                        <i class="fa-solid fa-car-side"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-lg tracking-tight text-white">Jaecoo J6 Owners SG</h1>
                        <p class="text-xs text-slate-400">Community Knowledge Base & FAQ</p>
                    </div>
                </div>
                <div class="flex items-center space-x-2 sm:space-x-3">
                    <span class="hidden sm:inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 mr-1.5 animate-pulse"></span>
                        Active Community DB
                    </span>
                    <a href="#supportModal" id="openSupportBtn" class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30 hover:bg-amber-500/20 transition-all shadow-lg cursor-pointer">
                        <i class="fa-solid fa-mug-hot"></i>
                        <span>Buy Me Milo</span>
                    </a>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <!-- Hero Search Section -->
            <div class="mb-8 text-center max-w-2xl mx-auto">
                <h2 class="text-3xl font-extrabold text-white tracking-tight sm:text-4xl mb-3">
                    Everything you need to know about the J6
                </h2>
                <p class="text-slate-400 text-sm sm:text-base mb-6">
                    Curated from community chat logs, troubleshooting guides, group buys, and owner experiences in Singapore.
                </p>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input type="text" id="searchInput" placeholder="Search keywords (e.g., Android Auto, frunk, V-Kool, LFP battery)..." 
                        class="w-full pl-11 pr-4 py-3.5 bg-slate-900 border border-slate-800 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent shadow-xl transition-all">
                </div>
            </div>

            <!-- Category Filter Pills (Contacts is placed first) -->
            <div class="flex flex-wrap justify-center gap-2 mb-8" id="categoryFilters">
                <button data-category="all" class="category-btn
